{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "sse-template",
    "description": "Implementation of a simple API with SSE.",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "keywords": [
        "express",
        "server",
        "events",
        "stream",
        "backend",
        "headers"
    ],
    "license": "MIT",
    "author": {
        "name": "Lucas",
        "email": "jlucasmelob558@gmail.com",
        "url": "https://github.com/lucaaszsx"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/lucaaszsx/sse-template.git"
    },
    "bugs": {
        "url": "https://github.com/lucaaszsx/sse-template/issues"
    },
    "homepage": "https://github.com/lucaaszsx/sse-template#README",
    "scripts": {
        "dev": "nodemon",
        "clean": "rimraf dist",
        "build": "tsc -p tsconfig.json",
        "start": "node .",
        "type-check": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format:check": "prettier --check .",
        "format:write": "prettier --write .",
        "check": "pnpm run type-check && pnpm run lint && pnpm run format:check",
        "fix": "pnpm lint:fix && pnpm format:write"
    },
    "packageManager": "pnpm@11.9.0",
    "dependencies": {
        "better-sqlite3": "^12.11.1",
        "dotenv": "^17.4.2",
        "express": "^5.2.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/express": "^5.0.6",
        "@types/node": "^26.0.1",
        "eslint": "^10.6.0",
        "eslint-config-prettier": "^10.1.8",
        "nodemon": "^3.1.14",
        "prettier": "^3.8.5",
        "rimraf": "^6.1.3",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.0"
    }
}
